# ==============================================================================
# CarePath NG — Production Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=production
# In Vercel, set this to your custom domain or Vercel generated URL:
# e.g. https://carepath-ng.vercel.app
NEXT_PUBLIC_APP_URL=https://carepath-ng.vercel.app

# ------------------------------------------------------------------------------
# Primary Healthcare Center (PHC) Facility Config
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_FACILITY_NAME="Garki Primary Healthcare Centre"
NEXT_PUBLIC_DEFAULT_FACILITY_CODE="FCT-AMAC-PHC-004"
NEXT_PUBLIC_DEFAULT_STATE="FCT Abuja"
NEXT_PUBLIC_DEFAULT_LGA="Abuja Municipal (AMAC)"

# ------------------------------------------------------------------------------
# Telephony & SMS Gateway (Termii Nigeria / Twilio)
# ------------------------------------------------------------------------------
# Choose provider: 'termii' (recommended for Nigerian telco & DND routes) | 'twilio' | 'simulation'
SMS_PROVIDER=simulation

# Termii Nigeria Configuration (https://termii.com)
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=CarePath
TERMII_API_URL=https://api.ng.termii.com/api/sms/send

# Twilio Configuration (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890

# ------------------------------------------------------------------------------
# Database & Storage
# ------------------------------------------------------------------------------
# CarePath NG includes a zero-config serverless-resilient database engine that automatically
# seeds and runs inside Vercel Serverless Functions (/tmp fallback with atomic durability).
