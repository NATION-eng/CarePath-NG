# ==============================================================================
# CarePath NG — Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Primary Healthcare Center (PHC) Facility Config
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_FACILITY_NAME="Garki Primary Healthcare Centre"
NEXT_PUBLIC_DEFAULT_FACILITY_CODE="FCT-AMAC-PHC-004"
NEXT_PUBLIC_DEFAULT_STATE="FCT Abuja"
NEXT_PUBLIC_DEFAULT_LGA="Abuja Municipal (AMAC)"

# ------------------------------------------------------------------------------
# Telephony & SMS Gateway (Termii Nigeria / Twilio)
# ------------------------------------------------------------------------------
# Choose provider: 'termii' (recommended for Nigerian DND routes) | 'twilio' | 'simulation'
SMS_PROVIDER=termii

# Termii Nigeria Configuration (https://termii.com)
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=CarePath
TERMII_API_URL=https://api.ng.termii.com/api/sms/send

# Twilio Configuration (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890

# ------------------------------------------------------------------------------
# PostgreSQL Database (Optional for remote connection, runs with persistent storage by default)
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:password@localhost:5432/carepath_ng?schema=public"
